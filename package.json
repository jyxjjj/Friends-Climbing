{
  "name": "summit-ledger",
  "version": "0.1.0",
  "description": "Friends Climbing team hiking planner, trip ledger, AA settlement and analytics app.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/jyxjjj/Friends-Climbing.git"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:artifact": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:worker && npm run test:artifact",
    "typecheck": "tsc --noEmit",
    "security:deps": "npm audit signatures && npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^8.29.2",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260809.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "displayName": "山行账本"
}
